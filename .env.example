BUZZWIRE_DB=data/buzzwire.db
# Production database. Leave blank locally to use SQLite.
# Use the Supabase Postgres connection string or pooler URL on Vercel.
DATABASE_URL=
BUZZWIRE_MODEL_PROVIDER=rule_based
BUZZWIRE_API_TIMEOUT=30
BUZZWIRE_FALLBACK_TO_RULE_BASED=true

# Set both values in production to password-protect the whole dashboard.
BUZZWIRE_AUTH_USERNAME=
BUZZWIRE_AUTH_PASSWORD=

# Use BUZZWIRE_MODEL_PROVIDER=auto to use the first key below.
# Or set it directly to openai, anthropic, gemini, or rule_based.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
